{
  "name": "medilog-edge",
  "version": "1.0.0",
  "description": "Offline-First Healthcare Platform for rural and community health workers",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "server": "nodemon backend/server.js",
    "backend": "nodemon backend/server.js",
    "client": "npm --prefix frontend run dev",
    "frontend": "npm --prefix frontend run dev",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "build": "npm --prefix frontend run build",
    "install-all": "npm install && npm --prefix backend install && npm --prefix frontend install"
  },
  "keywords": [
    "healthcare",
    "offline-first",
    "indexeddb",
    "pwa",
    "mern",
    "react",
    "express",
    "mongodb"
  ],
  "author": "MediLog Edge Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9"
  }
}
