PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/medilog-edge
JWT_SECRET=replace_with_a_secure_random_secret
GEMINI_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# Security & Rate Limiting Configuration
# AUTH_RATE_LIMIT_WINDOW_MS: Window in milliseconds for authentication rate limiting (default: 900000 = 15 minutes)
AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX: Max attempts per window per IP for auth endpoints (default: 5)
AUTH_RATE_LIMIT_MAX=5
# API_RATE_LIMIT_WINDOW_MS: Window in milliseconds for general API rate limiting (default: 900000 = 15 minutes)
API_RATE_LIMIT_WINDOW_MS=900000
# API_RATE_LIMIT_MAX: Max requests per window per IP for general API routes (default: 100)
API_RATE_LIMIT_MAX=100